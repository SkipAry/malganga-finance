# --- Database (Supabase Postgres) -------------------------------------------
# Both come from: Supabase dashboard > Project Settings > Database > Connection string
#
# DATABASE_URL  Transaction pooler (port 6543). Used by the running app.
#               Must carry ?pgbouncer=true so Prisma disables prepared statements.
# DIRECT_URL    Direct connection (port 5432). Used only by prisma migrate.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Auth --------------------------------------------------------------------
# Session signing key, minimum 32 characters. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="generate-a-real-one-per-environment"
