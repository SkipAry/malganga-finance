# --- Database (Supabase Postgres) -------------------------------------------
# Project: malganga-finance (ap-south-1). Replace [YOUR-PASSWORD] only.
# Source: Supabase dashboard > Connect > ORMs > Prisma
#
# DATABASE_URL  Transaction pooler (6543). Used by the running app.
#               connection_limit=1 matters on Vercel: each serverless instance
#               keeps its own Prisma pool, and without it a burst of concurrent
#               functions can exhaust the shared pooler.
# DIRECT_URL    Session pooler (5432). Used only by prisma migrate, which
#               cannot run through PgBouncer.
DATABASE_URL="postgresql://postgres.kqqypvgmozcztcbrdqdn:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.kqqypvgmozcztcbrdqdn:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Auth --------------------------------------------------------------------
# Session signing key, minimum 32 characters, different per environment.
#   openssl rand -base64 32
AUTH_SECRET="generate-a-real-one-per-environment"
